{
  "name": "australia-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "npm run typecheck:shell && npm run typecheck:game",
    "typecheck:shell": "tsc -p tsconfig.shell.json",
    "typecheck:game": "node scripts/typecheck-game-baseline.mjs",
    "typecheck:game:raw": "tsc -p tsconfig.game.json",
    "verify:standalone": "node scripts/verify-standalone-module.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:architecture": "node tests/source-architecture.mjs",
    "test:nav": "node src/intent-navigation/validate-contract.mjs",
    "test:integration": "node scripts/run-o111-integration-tests.mjs",
    "test:integration:gate-b2": "node scripts/run-o111-integration-gate.mjs b2",
    "test:integration:gate-final": "node scripts/run-o111-integration-gate.mjs final",
    "test:state-invariants": "npx --yes tsx scripts/run-agent-81-invariant-tests.ts",
    "test:transactions": "npx --yes tsx scripts/run-transaction-safety-self-tests.mjs",
    "test:e2e-gameplay": "npx --yes tsx scripts/run-e2e-gameplay-self-tests.mjs",
    "verify": "npm run verify:standalone && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
